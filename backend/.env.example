# Copy this file to .env and fill in real values before running the backend.
# Never commit the real .env file.

# --- Database ---
# Default: local SQLite file. Swap for a MySQL/PostgreSQL URL to migrate later.
DATABASE_URL=sqlite:///./resqai.db

# --- Auth ---
# Any long random string. Used to sign JWT access tokens.
JWT_SECRET_KEY=change-this-to-a-long-random-secret

# --- Maps / Hospitals ---
# Optional. If left blank, the hospital-lookup endpoint automatically falls
# back to clearly-labeled MOCK hospital data so the feature still works.
GOOGLE_MAPS_API_KEY=

# --- Emergency alerts ---
# "simulated" (default) never contacts a real service. See
# services/emergency_service.py for how to wire in a real SMS/call provider.
ALERT_CHANNEL=simulated
